{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noVar": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": { "ignoreNull": true }
        }
      },
      "style": {
        "useConst": "error",
        "useTemplate": "error",
        "useConsistentObjectDefinitions": {
          "level": "error",
          "options": { "syntax": "shorthand" }
        }
      },
      "complexity": {
        "useArrowFunction": "error",
        "noArguments": "error"
      }
    }
  }
}
