extends layout.pug

block childMainContent
    include includes/Chessboard.pug

    +buildChessBoard('theChessBoardInstance')

    p(id='FeedbackLabel')
    input(id='FindSolutionButton' type="button" value="Suche eine Lösung")

    //- module scope is not global, so the handler is attached here instead of via onclick
    script(type='module').
        import { App } from './js/ChessKnightProblem/App.js';

        const app = new App('theChessBoardInstance', 'FeedbackLabel');
        document.getElementById('FindSolutionButton').addEventListener('click', () => app.findAndDisplaySolution());
